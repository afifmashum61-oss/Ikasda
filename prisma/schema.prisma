generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agenda {
  id        String   @id @default(cuid())
  title     String
  date      String
  location  String
  description String?
  createdAt DateTime @default(now())
}

model Pengurus {
  id        String   @id @default(cuid())
  name      String
  position  String
  phone     String
  createdAt DateTime @default(now())
}